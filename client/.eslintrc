{
    "env": {
        "browser": true,
        "es2021": true,
        "node": true,
        "jest": true
    },
    "extends": [
        "eslint:recommended",
        "plugin:react/recommended"
    ],
    "parserOptions": {
        "ecmaVersion": 2021,
        "sourceType": "module",
        "ecmaFeatures": {
            "jsx": true
        }
    },
    "rules": {
        "react/prop-types": "off",
        "react/react-in-jsx-scope": "off",
        "no-unused-vars": "warn",
        "no-console": "off"
    },
    "settings": {
        "react": {
            "version": "detect"
        }
    },
    "globals": {
        "fetch": "readonly",
        "FormData": "readonly",
        "WebSocket": "readonly",
        "File": "readonly",
        "Blob": "readonly",
        "console": "readonly",
        "document": "readonly",
        "window": "readonly",
        "localStorage": "readonly",
        "sessionStorage": "readonly"
    }
}